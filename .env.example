# Database Configuration
DATABASE_URL=sqlite:///weighing_system.db

# Serial Port Configuration for Scale Indicator
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_BYTESIZE=8
SERIAL_PARITY=N
SERIAL_STOPBITS=1
SERIAL_TIMEOUT=1

# Mock Mode (set to True for testing without hardware)
MOCK_SERIAL=True

# Application Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
# WARNING: Set FLASK_DEBUG=False in production to prevent security vulnerabilities
FLASK_DEBUG=True

# Logging
LOG_LEVEL=INFO
